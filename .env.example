OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the primary Gemini model is overloaded; OpenAI is the last resort
GEMINI_FALLBACK_MODELS=gemini-3.6-flash
GEMINI_TIMEOUT_MS=25000
# Used only if every Gemini model fails; deliberately different from OPENAI_MODEL
OPENAI_VERIFIER_MODEL=gpt-4o
# How many of the 12 audit areas an upload debates
UPLOAD_MAX_PROBES=12
# Other websites allowed to call this API, comma separated (empty = none)
ALLOWED_ORIGINS=

CHROMA_PERSIST_DIRECTORY=data/indexes/chroma
MAX_DEBATE_ROUNDS=3
USE_GEMINI=true